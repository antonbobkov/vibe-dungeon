{
  "name": "undervault",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Undervault \u2014 a small top-down pixel-art dungeon action game (see spec/00-overview.md)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:site": "tsx tools/build-site.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:levels": "tsx tools/level-lint.ts levels",
    "route": "tsx tools/route.ts",
    "macro:compile": "tsx tools/macro-compile.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "replay:record": "tsx tools/replay-record.ts",
    "test:replay": "tsx tools/replay-test.ts",
    "sim": "tsx tools/sim-cli.ts",
    "test:e2e": "playwright test",
    "bench": "vitest run --config vitest.bench.config.ts --reporter=verbose",
    "test:visual": "playwright test -c playwright.visual.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
